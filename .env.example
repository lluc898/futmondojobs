# Futmondo account and championship
FUTMONDO_EMAIL=you@example.com
FUTMONDO_PASSWORD=change-me
FUTMONDO_CHAMPIONSHIP_ID=championship-id
FUTMONDO_TEAM_ID=team-id
# Optional override. Normally discovered automatically from the login response.
FUTMONDO_USER_ID=
FUTMONDO_DEVICE_ID=futmondojobs-production

# Telegram
TELEGRAM_BOT_TOKEN=123456:telegram-token
TELEGRAM_CHAT_ID=123456789
TELEGRAM_ALLOWED_CHAT_IDS=123456789
# Generate long random values for these secrets
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
API_KEY=replace-with-random-api-key
CRON_SECRET=replace-with-random-cron-secret

# Scheduler (standard five-field cron expressions)
TZ=Europe/Madrid
MARKET_DIGEST_CRON=0 7 * * *
TRANSFERS_DIGEST_CRON=45 7 * * *
MARKET_PLAYER_LIMIT=20
WANTED_MIN_CHANGE=80000

# Optional shared login-token cache. Leave empty to use process memory.
MONGODB_URI=

REQUEST_TIMEOUT_SECONDS=20
TOKEN_TTL_SECONDS=3300
LOG_LEVEL=INFO
